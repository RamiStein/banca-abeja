# Variables de entorno para conectar Firebase
# Crea un archivo .env.local en esta misma carpeta y pega aquí tus credenciales de Firebase Console

VITE_FIREBASE_API_KEY=tu_api_key_aqui
VITE_FIREBASE_AUTH_DOMAIN=banca-abeja.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=banca-abeja
VITE_FIREBASE_STORAGE_BUCKET=banca-abeja.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=tu_sender_id
VITE_FIREBASE_APP_ID=tu_app_id
